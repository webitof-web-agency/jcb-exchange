.env
.env.*
*.env
*/.env
*/.env.*
!.env.example
!*/.env.example

# Next.js Build Outputs
.next/
*/.next/
out/
*/out/

# Backend Build & Runtime Outputs
dist/
*/dist/
build/
*/build/
runtime/
*/runtime/
generated/prisma/
*/generated/prisma/

# Uploads & Temporary Directories
uploads/
*/uploads/
tmp/
*/tmp/

# Logs
*.log
*.err.log
*.out.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*



# IDE, Editor & OS Files
.vscode/
.idea/
.DS_Store
*.pem
Thumbs.db
ehthumbs.db

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts
*/next-env.d.ts

# Faltu scratch files ignore karein
/*.md
/*.txt
/*.csv
!README.md

# Mobile / React Native Build Outputs
*.apk
*.aab
*.keystore
!debug.keystore
*.jsbundle
*.hprof
*.iml
.gradle/
*/.gradle/
.idea/
*/.idea/
local.properties
*/local.properties
.cxx/
*/.cxx/
