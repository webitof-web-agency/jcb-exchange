model User {
  id               String     @id @default(uuid())
  mobile           String?    @unique
  email            String?    @unique
  password         String?
  name             String?
  avatarUrl        String?
  authProvider     String?    @default("LOCAL")
  role             Role       @default(CUSTOMER)
  status           UserStatus @default(ACTIVE)
  whatsappNumber   String?
  city             String?
  state            String?
  isMobileVerified Boolean    @default(false)
  authVersion      Int        @default(0)
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  customRoleId     String?
  fcmToken         String?
  pushSubscription Json?

  createdBy                          User?                              @relation("UserCreation", fields: [createdById], references: [id])
  createdUsers                       User[]                             @relation("UserCreation")
  adminProfile                       AdminProfile?
  adminPermissions                   AdminPermission[]
  customRole                         CustomRole?                        @relation("UserCustomRole", fields: [customRoleId], references: [id])
  partnerProfile                     PartnerProfile?
  teamMemberships                    PartnerTeamMember[]
  listings                           Listing[]
  leads                              Lead[]                             @relation("CustomerLeads")
  assignedLeads                      Lead[]                             @relation("DealerLeads")
  reviewedKycDocs                    KycDocument[]                      @relation("KycReviewer")
  kycReviewActions                   KycReviewLog[]                     @relation("KycReviewActor")
  verifiedDeposits                   PartnerDeposit[]                   @relation("DepositVerifier")
  acceptedAgreements                 PartnerAgreement[]                 @relation("AgreementAcceptor")
  approvedPartners                   PartnerProfile[]                   @relation("PartnerApprover")
  customerPrimeSubscriptions         CustomerPrimeSubscription[]        @relation("CustomerPrimeSubscriptions")
  approvedCustomerPrimeSubscriptions CustomerPrimeSubscription[]        @relation("CustomerPrimeApprover")
  rejectedCustomerPrimeSubscriptions CustomerPrimeSubscription[]        @relation("CustomerPrimeRejector")
  listingPaymentSubmissions          ListingPaymentSubmission[]         @relation("ListingPaymentBuyer")
  listingPaymentSellerSubmissions    ListingPaymentSubmission[]         @relation("ListingPaymentSeller")
  reviewedListingPaymentSubmissions  ListingPaymentSubmission[]         @relation("ListingPaymentReviewer")
  createdListingBills                ListingBill[]                      @relation("ListingBillCreator")
  auditLogs                          AuditLog[]                         @relation("AuditActor")
  drivingLicenseVerificationRecords  DrivingLicenseVerificationRecord[] @relation("DrivingLicenseVerificationRequester")
  rcOwnerHistoryRecords              RcOwnerHistoryRecord[]             @relation("RcOwnerHistoryRequester")
  rcChallanVerificationRecords       RcChallanVerificationRecord[]      @relation("RcChallanVerificationRequester")
  chassisToRcVerificationRecords     ChassisToRcVerificationRecord[]    @relation("ChassisToRcVerificationRequester")
  rcToMobileVerificationRecords      RcToMobileVerificationRecord[]     @relation("RcToMobileVerificationRequester")
  mobileToRcLookupRecords            MobileToRcLookupRecord[]           @relation("MobileToRcLookupRequester")
  rcMobileNumberCheckRecords         RcMobileNumberCheckRecord[]        @relation("RcMobileNumberCheckRequester")
  leadActivities                     LeadActivity[]                     @relation("LeadActivityActor")
  notifications                      Notification[]
  createdJobs                        Job[]                              @relation("JobCreator")
  assignedApplications               JobApplication[]                   @relation("AssignedRecruiter")
  stageHistoryChanges                ApplicationStageHistory[]          @relation("StageHistoryChanger")
  authoredCandidateNotes             CandidateNote[]                    @relation("CandidateNoteAuthor")
  submittedCandidateRatings          CandidateRating[]                  @relation("CandidateRatingEvaluator")
  scheduledInterviews                Interview[]                        @relation("InterviewScheduler")
  conductedInterviews                Interview[]                        @relation("Interviewer")
  submittedInterviewFeedbacks        InterviewFeedback[]                @relation("InterviewFeedbackAuthor")
  createdOffers                      Offer[]                            @relation("OfferCreator")
  recruitmentActivityLogs            RecruitmentActivityLog[]           @relation("RecruitmentActivityActor")
  mobileOtpChallenges                MobileOtpChallenge[]
  emailOtpChallenges                 EmailOtpChallenge[]
  panVerificationRecords             PanVerificationRecord[]            @relation("PanVerificationRequester")
  apiBillingUsageRecords             ApiUsageRecord[]                   @relation("ApiBillingUsageRequester")
  apiWalletLedgerEntries             ApiWalletLedger[]                  @relation("ApiWalletLedgerRequester")
  mobileToPanLookupRecords           MobileToPanLookupRecord[]           @relation("MobileToPanLookupRequester")
  gstVerificationRecords             GstVerificationRecord[]            @relation("GstVerificationRequester")
  blogQuestions                      BlogQuestion[]                     @relation("BlogQuestionAuthor")
  answeredBlogQuestions              BlogQuestion[]                     @relation("BlogQuestionAnswerer")
}

model MobileOtpChallenge {
  id           String                   @id @default(uuid())
  mobile       String
  userId       String?
  status       MobileOtpChallengeStatus @default(PENDING)
  attemptCount Int                      @default(0)
  resendCount  Int                      @default(0)
  createdAt    DateTime                 @default(now())
  lastSentAt   DateTime                 @default(now())
  expiresAt    DateTime
  verifiedAt   DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mobile, status, createdAt])
  @@index([userId, status, createdAt])
}

model EmailOtpIntegrationSettings {
  id                   String   @id @default("default")
  enabled              Boolean  @default(false)
  smtpHost             String   @default("smtp.gmail.com")
  smtpPort             Int      @default(465)
  smtpSecure           Boolean  @default(true)
  senderEmail          String?
  senderName           String   @default("JCB Exchange")
  encryptedAppPassword String?  @db.Text
  otpExpiryMinutes     Int      @default(10)
  otpLength            Int      @default(6)
  updatedAt            DateTime @updatedAt
  updatedByUserId      String?
}

model EmailOtpChallenge {
  id           String                  @id @default(uuid())
  email        String
  userId       String?
  otpHash      String
  status       EmailOtpChallengeStatus @default(PENDING)
  attemptCount Int                     @default(0)
  resendCount  Int                     @default(0)
  createdAt    DateTime                @default(now())
  lastSentAt   DateTime                @default(now())
  expiresAt    DateTime
  verifiedAt   DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, status, createdAt])
  @@index([userId, status, createdAt])
}

model AdminProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  title       String?
  isRootAdmin Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[] @relation("UserCustomRole")
}

model AdminPermission {
  id          String   @id @default(uuid())
  adminUserId String
  permission  String
  createdAt   DateTime @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id])

  @@unique([adminUserId, permission])
  @@index([adminUserId])
}

model PanVerificationRecord {
  id                 String                   @id @default(uuid())
  operation          PanVerificationOperation
  status             PanVerificationStatus    @default(PENDING)
  maskedPan          String
  requestFingerprint String?                  @db.VarChar(64)
  provider           String                   @default("SUREPASS")
  providerClientId   String?
  messageCode        String?
  safeMessage        String?                  @db.Text
  encryptedResult    String?                  @db.Text
  requestedById      String
  createdAt          DateTime                 @default(now())
  completedAt        DateTime?

  requestedBy User @relation("PanVerificationRequester", fields: [requestedById], references: [id])

  @@index([operation, createdAt])
  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([maskedPan, createdAt])
  @@index([operation, requestFingerprint, status, completedAt])
}

model PanVerificationSettings {
  id                  String   @id @default("default")
  enabled             Boolean  @default(false)
  activeEnvironment   SurepassEnvironment @default(SANDBOX)
  baseUrl             String?
  encryptedToken      String?  @db.Text
  encryptedCustomerId String?  @db.Text
  sandboxBaseUrl      String?
  encryptedSandboxToken String? @db.Text
  encryptedSandboxCustomerId String? @db.Text
  productionBaseUrl   String?
  encryptedProductionToken String? @db.Text
  encryptedProductionCustomerId String? @db.Text
  encryptedDataSecret String?  @db.Text
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

