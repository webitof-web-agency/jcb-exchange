  category        String                   @default("Miscellaneous")
  narration       String                   @db.Text
  reference       String?
  chequeNumber    String?
  invoiceNumber   String?
  attachmentUrl   String?
  notes           String?                  @db.Text
  source          FinanceTransactionSource @default(MANUAL)
  status          FinanceTransactionStatus @default(POSTED)
