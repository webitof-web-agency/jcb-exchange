generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PARTNER
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
  CLOSED
}

enum PartnerType {
  SHOWROOM
  BROKER
}

enum PartnerOnboardingStatus {
  ACCOUNT_CREATED
  PROFILE_PENDING
  KYC_PENDING
  DEPOSIT_PENDING
  AGREEMENT_PENDING
  REVIEW_PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum PartnerAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  CLOSED
}

enum KycStatus {
  NOT_STARTED
  INCOMPLETE
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum KycDocumentType {
  PAN_CARD
  AADHAAR_CARD
  PASSPORT_PHOTO
  CANCELLED_CHEQUE
  GST_CERTIFICATE
  AUTHORIZED_PERSON_ID
}

enum KycDocumentStatus {
  NOT_UPLOADED
  UPLOADED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  EXPIRED
}

enum ListingStatus {
  DRAFT
  PENDING_APPROVAL
  CHANGES_REQUESTED
  PUBLISHED
  PAUSED
  RESERVED
  SOLD
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  INSPECTION_SCHEDULED
  WON
  LOST
}

enum PartnerStaffRole {
  OWNER
  LISTING_MANAGER
  SALES_EXECUTIVE
  LEAD_MANAGER
  MEDIA_UPLOADER
  FINANCE_VIEWER
  READ_ONLY
}

enum DepositType {
  ONLINE_PAYMENT
  UPI_PAYMENT
  NET_BANKING
  BANK_TRANSFER
  CASH
  CHEQUE
  DEMAND_DRAFT
  BANK_GUARANTEE
  WAIVER_LETTER
  UNDERTAKING_LETTER
  EXCEPTION_APPROVAL
}

enum DepositStatus {
  NOT_SUBMITTED
  SUBMITTED
  VERIFICATION_PENDING
  VERIFIED
  REJECTED
  EXPIRED
  REFUND_REQUESTED
  REFUNDED
}

enum AgreementType {
  MARKETPLACE_TERMS
  PARTNER_TERMS
  LISTING_AUTHENTICITY
  MEDIA_OWNERSHIP
  SECURITY_DEPOSIT_POLICY
  REFUND_POLICY
  CUSTOMER_DATA_USAGE
  CONTACT_VISIBILITY_POLICY
  FRAUD_POLICY
  LISTING_SUSPENSION_POLICY
  SOLD_MEDIA_DELETION_POLICY
  FEATURED_IMAGE_RETENTION_CONSENT
  COMMISSION_POLICY
  LEAD_OWNERSHIP_POLICY
}

enum AuditEntityType {
  USER
  PARTNER_PROFILE
  KYC_DOCUMENT
  LISTING
  DEPOSIT
  AGREEMENT
  RECRUITMENT_JOB
  RECRUITMENT_APPLICATION
  RECRUITMENT_CANDIDATE
}

enum CustomerPrimeSubscriptionStatus {
  PENDING
  ACTIVE
  REJECTED
  EXPIRED
  CANCELLED
}
enum ListingPaymentMethod {
  RTGS
  RAZORPAY
  PHONEPE
}

enum ListingPaymentStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  FAILED
  PAID
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum WhatsAppRecipientType {
  CUSTOMER
  PARTNER
  SUPER_ADMIN
  RECRUITER
  CANDIDATE
  TEST
}

enum WhatsAppOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum WhatsAppConsentCategory {
  MARKETING
  JOB_ALERTS
}

enum WhatsAppCampaignStatus {
  DRAFT
  SENDING
  COMPLETED
  CANCELLED
}

enum SmsMessageStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum SmsOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum MobileOtpChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum EmailOtpChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
}

model User {
  id               String     @id @default(uuid())
  mobile           String?    @unique
  email            String?    @unique
  password         String?
  name             String?
  authProvider     String?    @default("LOCAL")
  role             Role       @default(CUSTOMER)
  status           UserStatus @default(ACTIVE)
  whatsappNumber   String?
  city             String?
  state            String?
  isMobileVerified Boolean    @default(false)
  authVersion      Int        @default(0)
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  customRoleId     String?
  fcmToken         String?
  pushSubscription Json?

  createdBy          User?                @relation("UserCreation", fields: [createdById], references: [id])
  createdUsers       User[]               @relation("UserCreation")
  adminProfile       AdminProfile?
  adminPermissions   AdminPermission[]
  customRole         CustomRole?          @relation("UserCustomRole", fields: [customRoleId], references: [id])
  partnerProfile     PartnerProfile?
  teamMemberships    PartnerTeamMember[]
  listings           Listing[]
  leads              Lead[]               @relation("CustomerLeads")
  assignedLeads      Lead[]               @relation("DealerLeads")
  reviewedKycDocs    KycDocument[]        @relation("KycReviewer")
  kycReviewActions   KycReviewLog[]       @relation("KycReviewActor")
  verifiedDeposits   PartnerDeposit[]     @relation("DepositVerifier")
  acceptedAgreements PartnerAgreement[]   @relation("AgreementAcceptor")
  approvedPartners   PartnerProfile[]     @relation("PartnerApprover")
  customerPrimeSubscriptions CustomerPrimeSubscription[] @relation("CustomerPrimeSubscriptions")
  approvedCustomerPrimeSubscriptions CustomerPrimeSubscription[] @relation("CustomerPrimeApprover")
  rejectedCustomerPrimeSubscriptions CustomerPrimeSubscription[] @relation("CustomerPrimeRejector")
  listingPaymentSubmissions ListingPaymentSubmission[] @relation("ListingPaymentBuyer")
  listingPaymentSellerSubmissions ListingPaymentSubmission[] @relation("ListingPaymentSeller")
  reviewedListingPaymentSubmissions ListingPaymentSubmission[] @relation("ListingPaymentReviewer")
  auditLogs          AuditLog[]           @relation("AuditActor")
  leadActivities     LeadActivity[]       @relation("LeadActivityActor")
  notifications      Notification[]
  createdJobs                Job[]                       @relation("JobCreator")
  assignedApplications       JobApplication[]            @relation("AssignedRecruiter")
  stageHistoryChanges        ApplicationStageHistory[]   @relation("StageHistoryChanger")
  authoredCandidateNotes     CandidateNote[]             @relation("CandidateNoteAuthor")
  submittedCandidateRatings CandidateRating[]            @relation("CandidateRatingEvaluator")
  scheduledInterviews        Interview[]                 @relation("InterviewScheduler")
  conductedInterviews        Interview[]                 @relation("Interviewer")
  submittedInterviewFeedbacks InterviewFeedback[]        @relation("InterviewFeedbackAuthor")
  createdOffers              Offer[]                     @relation("OfferCreator")
  recruitmentActivityLogs    RecruitmentActivityLog[]    @relation("RecruitmentActivityActor")
  mobileOtpChallenges        MobileOtpChallenge[]
  emailOtpChallenges         EmailOtpChallenge[]
}

model MobileOtpChallenge {
  id           String                   @id @default(uuid())
  mobile       String
  userId       String?
  status       MobileOtpChallengeStatus @default(PENDING)
  attemptCount Int                      @default(0)
  resendCount  Int                      @default(0)
  createdAt    DateTime                 @default(now())
  lastSentAt   DateTime                 @default(now())
  expiresAt    DateTime
  verifiedAt   DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mobile, status, createdAt])
  @@index([userId, status, createdAt])
}

model EmailOtpIntegrationSettings {
  id                    String   @id @default("default")
  enabled               Boolean  @default(false)
  smtpHost              String   @default("smtp.gmail.com")
  smtpPort              Int      @default(465)
  smtpSecure            Boolean  @default(true)
  senderEmail           String?
  senderName            String   @default("JCB Exchange")
  encryptedAppPassword  String?  @db.Text
  otpExpiryMinutes      Int      @default(10)
  otpLength             Int      @default(6)
  updatedAt             DateTime @updatedAt
  updatedByUserId       String?
}

model EmailOtpChallenge {
  id           String                  @id @default(uuid())
  email        String
  userId       String?
  otpHash      String
  status       EmailOtpChallengeStatus @default(PENDING)
  attemptCount Int                     @default(0)
  resendCount  Int                     @default(0)
  createdAt    DateTime                @default(now())
  lastSentAt   DateTime                @default(now())
  expiresAt    DateTime
  verifiedAt   DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, status, createdAt])
  @@index([userId, status, createdAt])
}

model AdminProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  title       String?
  isRootAdmin Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]   @relation("UserCustomRole")
}

model AdminPermission {
  id          String             @id @default(uuid())
  adminUserId String
  permission  String
  createdAt   DateTime           @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id])

  @@unique([adminUserId, permission])
  @@index([adminUserId])
}

model PartnerProfile {
  id                String                  @id @default(uuid())
  userId            String                  @unique
  ownerName         String?
  businessName      String?
  partnerType       PartnerType?
  businessAddress   String?
  district          String?
  pinCode           String?
  businessExperience String?
  expectedMonthlyListings Int?
  listingLimit      Int                     @default(5)
  referralCode      String?
  businessDescription String?               @db.Text
  businessLogoUrl   String?
  googleMapsLocation String?
  serviceAreas      String?
  workingHours      String?
  alternateMobile   String?
  websiteUrl        String?
  socialLinks       String?
  yearsInBusiness   Int?
  teamSize          Int?
  gstNumber         String?
  businessRegistrationNumber String?
  onboardingStatus  PartnerOnboardingStatus @default(ACCOUNT_CREATED)
  accountStatus     PartnerAccountStatus    @default(PENDING)
  kycStatus         KycStatus               @default(NOT_STARTED)
  depositStatus     DepositStatus           @default(NOT_SUBMITTED)
  contactPreference String?
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  approvedBy    User?              @relation("PartnerApprover", fields: [approvedById], references: [id])
  teamMembers   PartnerTeamMember[]
  categories    Category[]
  kycDocuments  KycDocument[]
  kycReviews    KycReviewLog[]
  deposits      PartnerDeposit[]
  agreements    PartnerAgreement[]

  @@index([onboardingStatus])
  @@index([accountStatus])
  @@index([kycStatus])
}

model PartnerTeamMember {
  id               String          @id @default(uuid())
  partnerProfileId String
  userId           String
  staffRole        PartnerStaffRole
  isPrimary        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  partnerProfile PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@unique([partnerProfileId, userId])
  @@index([userId])
}

model CategoryIcon {
  id        String     @id @default(uuid())
  name      String     @unique
  svgData   String     @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  categories Category[]
}

model Category {
  id               String          @id @default(uuid())
  partnerProfileId String?
  name             String
  iconId           String?

  partnerProfile PartnerProfile? @relation(fields: [partnerProfileId], references: [id])
  icon           CategoryIcon?   @relation(fields: [iconId], references: [id])
  listings       Listing[]

  @@index([partnerProfileId])
  @@unique([partnerProfileId, name])
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  models   Model[]
  listings Listing[]
}

model Model {
  id       String    @id @default(uuid())
  name     String
  brandId  String
  brand    Brand     @relation(fields: [brandId], references: [id])
  listings Listing[]
}

model Listing {
  id                String        @id @default(uuid())
  partnerId         String
  categoryId        String
  brandId           String
  modelId           String
  title             String
  price             Decimal
  isNegotiable      Boolean       @default(false)
  manufacturingYear Int
  operatingHours    Int?
  locationState     String
  locationCity      String
  address           String?
  condition         String?
  description       String?       @db.Text
  additionalDescription String?   @db.Text
  grossPower        String?
  status            ListingStatus @default(DRAFT)
  soldAt            DateTime?
  contactMode       String?
  views             Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  partner    User        @relation(fields: [partnerId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  brand      Brand       @relation(fields: [brandId], references: [id])
  model      Model       @relation(fields: [modelId], references: [id])
  media      Media[]
  leads      Lead[]
  saleRecord SaleRecord?
  paymentSubmissions ListingPaymentSubmission[]
  rtoRecords        VehicleRtoRecord[]

  @@index([status, soldAt])
}

enum RtoHirePurchaseStatus {
  PENDING
  ACTIVE
  TERMINATED
  NOT_APPLICABLE
}

enum RtoValidityStatus {
  VALID
  EXPIRED
  NOT_AVAILABLE
  LIFETIME
  NOT_APPLICABLE
  PENDING
}

enum RtoHsrpStatus {
  YES
  NO
  PENDING
  NOT_APPLICABLE
}

enum RtoWorkStatus {
  PENDING
  IN_PROGRESS
  DOCUMENT_REQUIRED
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model VehicleRtoRecord {
  id                    String                 @id @default(uuid())
  listingId             String?
  customerName          String
  customerNumber        String
  vehicleNumber         String
  vehicleType           String
  vehicleModel          String
  hirePurchaseStatus    RtoHirePurchaseStatus @default(PENDING)
  taxStatus             RtoValidityStatus     @default(NOT_AVAILABLE)
  taxValidUntil         DateTime?
  fitnessStatus         RtoValidityStatus     @default(NOT_AVAILABLE)
  fitnessValidUntil     DateTime?
  insuranceStatus       RtoValidityStatus     @default(NOT_AVAILABLE)
  insuranceValidUntil   DateTime?
  pucStatus             RtoValidityStatus     @default(NOT_AVAILABLE)
  pucValidUntil         DateTime?
  hsrpStatus            RtoHsrpStatus        @default(PENDING)
  sellerName            String
  sellerNumber          String
  purchaserName         String
  purchaserNumber       String
  rtoOffice             String
  rtoAgentName          String
  rtoAgentState         String
  rtoAgentCity          String
  rtoAgentNumber        String
  rtoExpenses           Decimal              @default(0) @db.Decimal(12, 2)
  rtoExpensesAdvance    Decimal              @default(0) @db.Decimal(12, 2)
  documentSendDate      DateTime?
  rtoStatus             RtoWorkStatus        @default(PENDING)
  noteSheet             String?              @db.Text
  vehicleMaintenanceCost Decimal             @default(0) @db.Decimal(12, 2)
  hourRunning          Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  listing               Listing?              @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([vehicleNumber])
  @@index([rtoStatus])
  @@index([documentSendDate])
  @@index([rtoAgentState, rtoAgentCity])
}

model AnalyticsEvent {
  id                 String   @id @default(uuid())
  eventType          String
  anonymousId        String?
  sessionId          String?
  actorUserId        String?
  listingId          String?
  partnerId          String?
  brandId            String?
  modelId            String?
  categoryId         String?
  manufacturingYear  Int?
  query              String?
  filterPayload      Json?
  resultCount        Int?
  source             String?
  dedupeKey          String?  @unique
  occurredAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([listingId, eventType, occurredAt])
  @@index([partnerId, eventType, occurredAt])
  @@index([modelId, manufacturingYear, eventType, occurredAt])
  @@index([anonymousId, eventType, occurredAt])
}

model ListingPaymentSubmission {
  id                 String               @id @default(uuid())
  listingId          String
  buyerId            String
  partnerId          String
  method             ListingPaymentMethod
  status             ListingPaymentStatus @default(PENDING_VERIFICATION)
  amount             Decimal              @db.Decimal(12, 2)
  customerCity       String?
  customerState      String?
  transactionRef     String?
  paymentNote        String?              @db.Text
  receiptUrl         String?
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  phonepeMerchantOrderId String?
  phonepeOrderId     String?
  phonepeTransactionId String?
  settingsSnapshot   Json
  reviewedByUserId   String?
  reviewedAt         DateTime?
  rejectionReason    String?              @db.Text
  submittedAt        DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer      User    @relation("ListingPaymentBuyer", fields: [buyerId], references: [id])
  partner    User    @relation("ListingPaymentSeller", fields: [partnerId], references: [id])
  reviewedBy User?   @relation("ListingPaymentReviewer", fields: [reviewedByUserId], references: [id])

  @@index([listingId, status])
  @@index([buyerId, status])
  @@index([partnerId, status])
  @@index([submittedAt])
}

model SaleRecord {
  id         String   @id @default(uuid())
  listingId  String   @unique
  buyerName  String
  buyerPhone String
  buyerCity  String?
  buyerState String?
  soldPrice  Decimal  @db.Decimal(12, 2)
  soldAt     DateTime @default(now())
  invoiceNo  String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([soldAt])
}

model Media {
  id            String    @id @default(uuid())
  listingId     String
  url           String
  type          String
  slot          String?
  isFeatured    Boolean   @default(false)
  toBeDeletedAt DateTime?
  createdAt     DateTime  @default(now())

  listing Listing @relation(fields: [listingId], references: [id])
}

model Lead {
  id          String     @id @default(uuid())
  listingId   String?
  customerId  String
  dealerId    String
  enquiryType String
  message     String?    @db.Text
  status      LeadStatus @default(NEW)
  listingTitleSnapshot String?
  listingStatusSnapshot String?
  listingPriceSnapshot Decimal?
  listingLocationCitySnapshot String?
  listingLocationStateSnapshot String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  listing  Listing? @relation(fields: [listingId], references: [id])
  customer User    @relation("CustomerLeads", fields: [customerId], references: [id])
  dealer   User    @relation("DealerLeads", fields: [dealerId], references: [id])
  activities LeadActivity[]

  @@index([listingId])
  @@index([customerId])
  @@index([dealerId])
  @@index([status])
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  actorId   String?
  type      String   // 'CREATED' | 'STATUS_CHANGE' | 'NOTE' | 'CALL' | 'WHATSAPP' | 'FOLLOW_UP' | 'ROUTING_UPDATE'
  title     String
  content   String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation("LeadActivityActor", fields: [actorId], references: [id])

  @@index([leadId, createdAt])
}


model KycDocument {
  id               String            @id @default(uuid())
  partnerProfileId String
  documentType     KycDocumentType
  fileUrl          String
  fileName         String?
  documentNumber   String?
  nameOnDocument   String?
  issueDate        DateTime?
  expiryDate       DateTime?
  submittedNote    String?           @db.Text
  status           KycDocumentStatus @default(UPLOADED)
  reviewComment    String?           @db.Text
  reviewedById     String?
  reviewedAt       DateTime?
  uploadedAt       DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  partnerProfile PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  reviewedBy     User?          @relation("KycReviewer", fields: [reviewedById], references: [id])
  reviewLogs     KycReviewLog[]

  @@index([partnerProfileId, status])
}

model KycReviewLog {
  id               String   @id @default(uuid())
  partnerProfileId String
  kycDocumentId    String?
  action           String
  comment          String?  @db.Text
  actorUserId      String
  createdAt        DateTime @default(now())

  partnerProfile PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  kycDocument    KycDocument?   @relation(fields: [kycDocumentId], references: [id])
  actorUser      User           @relation("KycReviewActor", fields: [actorUserId], references: [id])

  @@index([partnerProfileId, createdAt])
}

model PartnerDeposit {
  id               String        @id @default(uuid())
  partnerProfileId String
  depositType      DepositType
  amount           Decimal?
  referenceNo      String?
  paymentDate      DateTime?
  paymentMode      String?
  receiptUrl       String?
  bankDetails      String?       @db.Text
  lockInPeriodDays Int?
  refundEligibleOn DateTime?
  guaranteeExpiryDate DateTime?
  notes            String?       @db.Text
  status           DepositStatus @default(SUBMITTED)
  verifiedById     String?
  verifiedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  partnerProfile PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  verifiedBy     User?          @relation("DepositVerifier", fields: [verifiedById], references: [id])

  @@index([partnerProfileId, status])
}

model PartnerAgreement {
  id               String        @id @default(uuid())
  partnerProfileId String
  agreementType    AgreementType
  version          String
  acceptedAt       DateTime      @default(now())
  acceptedByUserId String
  ipAddress        String?
  createdAt        DateTime      @default(now())

  partnerProfile PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  acceptedByUser User           @relation("AgreementAcceptor", fields: [acceptedByUserId], references: [id])

  @@unique([partnerProfileId, agreementType, version])
}

model AuditLog {
  id          String          @id @default(uuid())
  actorUserId String
  entityType  AuditEntityType
  entityId    String
  action      String
  beforeJson  Json?
  afterJson   Json?
  ipAddress   String?
  createdAt   DateTime        @default(now())

  actorUser User @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String?  
  isRead    Boolean  @default(false)
  link      String?  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerPrimeSubscription {
  id                 String                          @id @default(uuid())
  userId             String
  status             CustomerPrimeSubscriptionStatus @default(PENDING)
  transactionRef     String?
  paymentNote        String?                         @db.Text
  receiptUrl         String?
  paidAmount         Decimal
  customerCity       String?
  customerState      String?
  paidUpiId          String?
  settingsSnapshot   Json
  startedAt          DateTime?
  expiresAt          DateTime?
  submittedAt        DateTime                        @default(now())
  approvedByUserId   String?
  approvedAt         DateTime?
  rejectedByUserId   String?
  rejectedAt         DateTime?
  rejectionReason    String?                         @db.Text
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  user       User   @relation("CustomerPrimeSubscriptions", fields: [userId], references: [id])
  approvedBy User?  @relation("CustomerPrimeApprover", fields: [approvedByUserId], references: [id])
  rejectedBy User?  @relation("CustomerPrimeRejector", fields: [rejectedByUserId], references: [id])

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([submittedAt])
}

model TranslationOverride {
  id             String   @id @default(uuid())
  app            String
  locale         String
  translationKey String   @map("translation_key")
  value          String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([app, locale, translationKey])
  @@index([app, locale])
  @@map("translation_overrides")
}

model TranslationKeyRegistry {
  id             String   @id @default(uuid())
  app            String
  translationKey String   @map("translation_key")
  baseValue      String   @db.Text @map("base_value")
  namespace      String
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([app, translationKey])
  @@index([app])
  @@index([app, namespace])
  @@index([app, lastSeenAt])
  @@map("translation_key_registry")
}

model PlatformRuntimeSettings {
  key       String   @id
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_runtime_settings")
}

model WhatsAppIntegrationSettings {
  id                           String   @id @default("default")
  enabled                      Boolean  @default(false)
  graphApiVersion              String   @default("v23.0")
  phoneNumberId                String?
  businessAccountId            String?
  testRecipientPhone           String?
  encryptedAccessToken         String?  @db.Text
  encryptedWebhookVerifyToken  String?  @db.Text
  encryptedAppSecret           String?  @db.Text
  updatedByUserId              String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("whatsapp_integration_settings")
}

model WhatsAppMetaTemplate {
  id              String   @id @default(uuid())
  metaTemplateId  String?  @unique
  name            String
  language        String   @default("en_US")
  category        String?
  status          String   @default("DRAFT")
  components      Json?
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  automationRules WhatsAppAutomationRule[]
  campaigns       WhatsAppCampaign[]

  @@unique([name, language])
  @@index([status])
  @@map("whatsapp_meta_templates")
}

model WhatsAppAutomationRule {
  id              String   @id @default(uuid())
  eventCode       String   @unique
  enabled         Boolean  @default(false)
  templateId      String?
  recipientPolicy String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template WhatsAppMetaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@map("whatsapp_automation_rules")
}

model WhatsAppMessageLog {
  id                String                 @id @default(uuid())
  eventCode         String
  relatedEntityType String?
  relatedEntityId   String?
  recipientType     WhatsAppRecipientType
  recipientPhone    String
  status            WhatsAppMessageStatus  @default(QUEUED)
  metaMessageId     String?                @unique
  errorCode         String?
  errorMessage      String?                @db.Text
  payloadSnapshot   Json?
  dedupeKey         String?                @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  outbox WhatsAppOutbox?

  @@index([eventCode, createdAt])
  @@index([relatedEntityType, relatedEntityId])
  @@index([recipientType, status, createdAt])
  @@map("whatsapp_message_logs")
}

model WhatsAppOutbox {
  id            String               @id @default(uuid())
  messageLogId  String               @unique
  payload       Json
  status        WhatsAppOutboxStatus @default(PENDING)
  attempts      Int                  @default(0)
  nextAttemptAt DateTime?            @default(now())
  lockedAt      DateTime?
  processedAt   DateTime?
  lastError     String?              @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  messageLog WhatsAppMessageLog @relation(fields: [messageLogId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("whatsapp_outbox")
}

model SmsIntegrationSettings {
  id                 String   @id @default("default")
  enabled            Boolean  @default(false)
  baseUrl            String   @default("https://sms.flowitof.com/dev")
  senderId           String?
  testRecipientPhone String?
  smsDetails         String   @default("0")
  encryptedApiKey    String?  @db.Text
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("sms_integration_settings")
}

model SmsAutomationRule {
  id                String   @id @default(uuid())
  eventCode         String   @unique
  enabled           Boolean  @default(false)
  messageId         String?
  variablesTemplate String?  @db.Text
  recipientPolicy   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([enabled])
  @@map("sms_automation_rules")
}

model SmsMessageLog {
  id                String           @id @default(uuid())
  eventCode         String
  relatedEntityType String?
  relatedEntityId   String?
  recipientType     String
  recipientPhone    String
  status            SmsMessageStatus @default(QUEUED)
  providerMessageId String?
  errorCode         String?
  errorMessage      String?          @db.Text
  payloadSnapshot   Json?
  dedupeKey         String?          @unique
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  outbox SmsOutbox?

  @@index([eventCode, createdAt])
  @@index([relatedEntityType, relatedEntityId])
  @@index([recipientType, status, createdAt])
  @@map("sms_message_logs")
}

model SmsOutbox {
  id            String          @id @default(uuid())
  messageLogId  String          @unique
  payload       Json
  status        SmsOutboxStatus @default(PENDING)
  attempts      Int             @default(0)
  nextAttemptAt DateTime?       @default(now())
  lockedAt      DateTime?
  processedAt   DateTime?
  lastError     String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messageLog SmsMessageLog @relation(fields: [messageLogId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("sms_outbox")
}

model WhatsAppConsent {
  id        String                   @id @default(uuid())
  phone     String
  category  WhatsAppConsentCategory
  optedIn   Boolean                  @default(false)
  source    String?
  updatedByUserId String?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@unique([phone, category])
  @@index([category, optedIn])
  @@map("whatsapp_consents")
}

model WhatsAppCampaign {
  id              String                 @id @default(uuid())
  name            String
  category        WhatsAppConsentCategory
  templateId      String
  status          WhatsAppCampaignStatus @default(DRAFT)
  audienceFilters Json?
  createdByUserId String
  confirmedByUserId String?
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  template   WhatsAppMetaTemplate       @relation(fields: [templateId], references: [id])
  recipients WhatsAppCampaignRecipient[]

  @@index([status, createdAt])
  @@map("whatsapp_campaigns")
}

model WhatsAppCampaignRecipient {
  id              String                 @id @default(uuid())
  campaignId      String
  recipientType   WhatsAppRecipientType
  recipientPhone  String
  sourceEntityType String?
  sourceEntityId  String?
  messageLogId    String?
  status          WhatsAppMessageStatus  @default(QUEUED)
  errorMessage    String?                @db.Text
  sentAt          DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  campaign WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipientPhone])
  @@index([campaignId, status])
  @@map("whatsapp_campaign_recipients")
}

model Country {
  id              Int     @id
  name            String
  iso3            String?
  iso2            String?
  numericCode     String?
  phonecode       String?
  capital         String?
  currency        String?
  currencyName    String?
  currencySymbol  String?
  tld             String?
  native          String?
  region          String?
  subregion       String?
  nationality     String?
  latitude        String?
  longitude       String?
  emoji           String?
  emojiU          String?

  states          State[]
  cities          City[]
}

model State {
  id           Int     @id
  name         String
  countryId    Int
  countryCode  String?
  stateCode    String?
  latitude     String?
  longitude    String?

  country      Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities       City[]

  @@index([countryId])
}

model City {
  id           Int     @id
  name         String
  stateId      Int
  stateCode    String?
  countryId    Int
  countryCode  String?
  latitude     String?
  longitude    String?

  state        State   @relation(fields: [stateId], references: [id], onDelete: Cascade)
  country      Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([stateId])
  @@index([countryId])
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  FREELANCE
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  FRESHER
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  EXECUTIVE
}

enum CustomQuestionType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  YES_NO
  DROPDOWN
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum CandidateEmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  SERVING_NOTICE
  FREELANCER
  STUDENT
}

enum DocumentCategory {
  RESUME
  COVER_LETTER
  PORTFOLIO
  OFFER_LETTER
  OTHER
}

enum InterviewType {
  PHONE
  VIDEO
  IN_PERSON
}

enum InterviewStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum InterviewRecommendation {
  STRONG_HIRE
  HIRE
  MAYBE
  NO_HIRE
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum TalentPoolCategory {
  SALES
  OPERATIONS
  TECHNOLOGY
  FINANCE
  MANAGEMENT
  OTHER
}

model JobDepartment {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs        Job[]
}

model Job {
  id                   String             @id @default(uuid())
  title                String
  slug                 String             @unique
  jobCode              String             @unique
  departmentId         String
  vacancies            Int                @default(1)
  employmentType       EmploymentType     @default(FULL_TIME)
  workMode             WorkMode           @default(ON_SITE)
  locationCity         String
  locationState        String
  locationAddress      String?
  minExperience        Float              @default(0)
  maxExperience        Float?
  minSalary            Decimal?           @db.Decimal(12, 2)
  maxSalary            Decimal?           @db.Decimal(12, 2)
  currency             String             @default("INR")
  salaryVisibility     Boolean            @default(true)
  educationRequirement String?
  summary              String?            @db.Text
  description          String             @db.Text
  responsibilities     String[]
  requirements         String[]
  preferredSkills      String[]
  benefits             String[]
  workingHours         String?
  aboutCompany         String?            @db.Text
  startDate            DateTime?
  deadline             DateTime?
  resumeRequired       Boolean            @default(true)
  coverLetterRequired  Boolean            @default(false)
  seoTitle             String?
  metaDescription      String?            @db.Text
  ogImage              String?
  canonicalUrl         String?
  status               JobStatus          @default(DRAFT)
  postedAt             DateTime?
  closedAt             DateTime?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  department           JobDepartment      @relation(fields: [departmentId], references: [id])
  createdBy            User?              @relation("JobCreator", fields: [createdById], references: [id])
  customQuestions      JobCustomQuestion[]
  applications         JobApplication[]
  interviews           Interview[]
  offers               Offer[]

  @@index([status, postedAt])
  @@index([departmentId])
  @@index([employmentType])
  @@index([workMode])
}

model JobCustomQuestion {
  id          String             @id @default(uuid())
  jobId       String
  question    String
  type        CustomQuestionType @default(SHORT_TEXT)
  options     String[]
  isRequired  Boolean            @default(false)
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  job         Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers     ApplicationAnswer[]

  @@index([jobId])
}

model Candidate {
  id                 String                     @id @default(uuid())
  fullName           String
  email              String                     @unique
  mobile             String                     @unique
  currentCity        String?
  state              String?
  address            String?
  currentCompany     String?
  currentDesignation String?
  totalExperience    Float?
  relevantExperience Float?
  currentCtc         Decimal?                   @db.Decimal(12, 2)
  expectedCtc        Decimal?                   @db.Decimal(12, 2)
  noticePeriod       String?
  employmentStatus   CandidateEmploymentStatus?
  linkedInUrl        String?
  portfolioUrl       String?
  coverLetter        String?                    @db.Text
  talentPoolCategory TalentPoolCategory?
  inTalentPool       Boolean                    @default(false)
  talentPoolNotes    String?                    @db.Text
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  applications       JobApplication[]
  documents          CandidateDocument[]
  notes              CandidateNote[]
  ratings            CandidateRating[]
  interviews         Interview[]
  offers             Offer[]
  activityLogs       RecruitmentActivityLog[]

  @@index([email])
  @@index([mobile])
  @@index([inTalentPool])
}

model JobApplication {
  id                  String                    @id @default(uuid())
  applicationRef      String                    @unique
  jobId               String
  candidateId         String
  currentStage        String                    @default("NEW")
  terminalStatus      String?
  assignedRecruiterId String?
  overallRating       Float?
  isDuplicateOverride Boolean                   @default(false)
  appliedAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  job                 Job                       @relation(fields: [jobId], references: [id])
  candidate           Candidate                 @relation(fields: [candidateId], references: [id])
  assignedRecruiter   User?                     @relation("AssignedRecruiter", fields: [assignedRecruiterId], references: [id])
  answers             ApplicationAnswer[]
  documents           CandidateDocument[]
  stageHistory        ApplicationStageHistory[]
  notes               CandidateNote[]
  ratings             CandidateRating[]
  interviews          Interview[]
  offers              Offer[]
  activityLogs        RecruitmentActivityLog[]

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([currentStage])
  @@index([appliedAt])
}

model ApplicationAnswer {
  id            String            @id @default(uuid())
  applicationId String
  questionId    String
  answerText    String?           @db.Text
  answerJson    Json?
  createdAt     DateTime          @default(now())

  application   JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      JobCustomQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([questionId])
}

model CandidateDocument {
  id            String           @id @default(uuid())
  candidateId   String
  applicationId String?
  category      DocumentCategory @default(RESUME)
  fileName      String
  fileUrl       String
  fileSize      Int?
  mimeType      String?
  uploadedAt    DateTime         @default(now())

  candidate     Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application   JobApplication?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([applicationId])
}

model ApplicationStage {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  order       Int      @default(0)
  color       String?  @default("blue")
  isSystem    Boolean  @default(false)
  isTerminal  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApplicationStageHistory {
  id                 String         @id @default(uuid())
  applicationId      String
  fromStage          String?
  toStage            String
  fromTerminalStatus String?
  toTerminalStatus   String?
  changedById        String?
  notes              String?        @db.Text
  createdAt          DateTime       @default(now())

  application        JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy          User?          @relation("StageHistoryChanger", fields: [changedById], references: [id])

  @@index([applicationId, createdAt])
}

model CandidateNote {
  id            String          @id @default(uuid())
  candidateId   String
  applicationId String?
  authorId      String
  content       String          @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User            @relation("CandidateNoteAuthor", fields: [authorId], references: [id])

  @@index([candidateId])
  @@index([applicationId])
}

model CandidateRating {
  id                  String          @id @default(uuid())
  candidateId         String
  applicationId       String?
  evaluatorId         String
  overallRating       Int
  communicationRating Int?
  technicalRating     Int?
  experienceRating    Int?
  cultureFitRating    Int?
  feedback            String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  candidate           Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application         JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluator           User            @relation("CandidateRatingEvaluator", fields: [evaluatorId], references: [id])

  @@index([candidateId])
  @@index([applicationId])
}

model Interview {
  id              String            @id @default(uuid())
  applicationId   String
  candidateId     String
  jobId           String
  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  type            InterviewType     @default(VIDEO)
  status          InterviewStatus   @default(SCHEDULED)
  interviewerId   String?
  meetingUrl      String?
  location        String?
  notes           String?           @db.Text
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  application     JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate       Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job             Job               @relation(fields: [jobId], references: [id])
  interviewer     User?             @relation("Interviewer", fields: [interviewerId], references: [id])
  createdBy       User?             @relation("InterviewScheduler", fields: [createdById], references: [id])
  feedback        InterviewFeedback[]

  @@index([applicationId])
  @@index([candidateId])
  @@index([scheduledAt])
}

model InterviewFeedback {
  id                  String                  @id @default(uuid())
  interviewId         String
  interviewerId       String
  communicationRating Int?
  technicalRating     Int?
  experienceRating    Int?
  overallRating       Int
  strengths           String?                 @db.Text
  weaknesses          String?                 @db.Text
  notes               String?                 @db.Text
  recommendation      InterviewRecommendation @default(HIRE)
  submittedAt         DateTime                @default(now())

  interview           Interview               @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer         User                    @relation("InterviewFeedbackAuthor", fields: [interviewerId], references: [id])

  @@index([interviewId])
}

model Offer {
  id               String      @id @default(uuid())
  applicationId    String
  candidateId      String
  jobId            String
  designation      String
  department       String
  joiningLocation  String
  ctc              Decimal     @db.Decimal(12, 2)
  joiningDate      DateTime?
  probationPeriod  String?
  reportingManager String?
  offerValidUntil  DateTime?
  additionalTerms  String?     @db.Text
  offerLetterUrl   String?
  status           OfferStatus @default(DRAFT)
  createdById      String?
  sentAt           DateTime?
  respondedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  application      JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate        Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job              Job            @relation(fields: [jobId], references: [id])
  createdBy        User?          @relation("OfferCreator", fields: [createdById], references: [id])

  @@index([applicationId])
  @@index([candidateId])
  @@index([status])
}

model RecruitmentEmailTemplate {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  subject     String
  bodyHtml    String   @db.Text
  variables   String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RecruitmentActivityLog {
  id            String          @id @default(uuid())
  candidateId   String?
  applicationId String?
  actorId       String?
  action        String
  title         String
  details       String?         @db.Text
  metadata      Json?
  createdAt     DateTime        @default(now())

  candidate     Candidate?      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User?           @relation("RecruitmentActivityActor", fields: [actorId], references: [id])

  @@index([applicationId, createdAt])
  @@index([candidateId, createdAt])
}
