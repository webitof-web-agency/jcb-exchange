model ApiWallet {
  id           String         @id @default("platform")
  currency     String         @default("INR") @db.VarChar(3)
  balancePaise Int            @default(0)
  mode         ApiBillingMode @default(DISABLED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  ledgerEntries ApiWalletLedger[]
  usageRecords  ApiUsageRecord[]
}

model ApiServicePrice {
  serviceKey      ApiBillableService @id
  amountPaise     Int
  active          Boolean            @default(false)
  version         Int                @default(1)
  updatedBySource String?            @db.VarChar(64)
  updatedAt       DateTime           @updatedAt
  createdAt       DateTime           @default(now())
}

model ApiUsageRecord {
  id                   String             @id @default(uuid())
  walletId             String
  serviceKey           ApiBillableService
  verificationRecordId String             @db.VarChar(100)
  providerAttemptId    String             @unique @db.VarChar(100)
  requestedById        String
  amountPaise          Int
  priceVersion         Int
  currency             String             @default("INR") @db.VarChar(3)
  createdAt            DateTime           @default(now())

  wallet      ApiWallet       @relation(fields: [walletId], references: [id])
