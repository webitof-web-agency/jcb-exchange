# Docker / Dokploy Production Environment Template (copy to .env on VPS/Dokploy; never commit secrets!)

# --- GHCR Image References ---
BACKEND_IMAGE=ghcr.io/<github-owner>/jcbexchange-backend:latest
FRONTEND_IMAGE=ghcr.io/<github-owner>/jcbexchange-frontend:latest
ADMIN_PORTAL_IMAGE=ghcr.io/<github-owner>/jcbexchange-admin-portal:latest

# --- Host Port Bindings (set BIND_IP=127.0.0.1 behind Nginx/Traefik) ---
API_BIND_IP=127.0.0.1
API_PORT=5002
WEB_BIND_IP=127.0.0.1
WEB_PORT=3000
PORTAL_BIND_IP=127.0.0.1
PORTAL_PORT=3001

# --- Public Build Args (baked into Next.js images at GitHub Actions build time) ---
NEXT_PUBLIC_API_URL=https://api.jcbexchange.com/api
NEXT_PUBLIC_SITE_URL=https://jcbexchange.com
NEXT_PUBLIC_PUBLIC_SITE_URL=https://jcbexchange.com
NEXT_PUBLIC_FRONTEND_URL=https://jcbexchange.com
NEXT_PUBLIC_PARTNER_PORTAL_URL=https://admin.jcbexchange.com
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=15

# --- Backend Runtime Secrets (configure directly in Dokploy service env) ---
DATABASE_URL=postgresql://user:password@host:5432/jcbexchange
JWT_SECRET=replace-with-strong-secret
ENABLE_BACKGROUND_JOBS=true
CORS_ORIGIN=https://jcbexchange.com,https://admin.jcbexchange.com
FRONTEND_URL=https://jcbexchange.com
ADMIN_PORTAL_URL=https://admin.jcbexchange.com
